{
  "expo": {
    "name": "Forage",
    "slug": "forage",
    "version": "1.0.0",
    "scheme": "com.forage.app",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forage.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4e705e"
      },
      "package": "com.forage.app"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Forage uses your location to tag discoveries and expeditions."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Forage saves expedition photos you choose to your library.",
          "savePhotosPermission": "Forage saves expedition photos you choose to your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
